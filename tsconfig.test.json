{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "vitest/globals",
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "tests/**/*.ts",
    "vitest.config.ts",
    "lib/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
