# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Label Studio
LABEL_STUDIO_API_URL=https://annotate.senebiclabs.com
LABEL_STUDIO_API_TOKEN=your_label_studio_api_token

# Auth
MAGIC_LINK_SECRET=your_secret_for_signing_magic_links
JWT_SECRET=your_jwt_secret_for_sessions
MAGIC_LINK_EXPIRY_HOURS=24

# Email (Resend for magic links)
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=noreply@senebiclabs.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Operator key for internal ops endpoints (/api/internal/preview, /api/tasks/reconcile).
# NOT a client credential — the client deliverable is produced by the HEALTH backend.
OPS_API_KEY=

# Google sign-in — create an OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
# Without these, /login hides nothing but Google returns ?error=google_unavailable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Calibration gating. Off (default) means an invitation grants access directly;
# on means access is earned per pool by passing that pool's calibration.
NEXT_PUBLIC_CALIBRATION_ENABLED=false

# --- Auth secrets -----------------------------------------------------------
# All must be at least 32 characters. Generate with: openssl rand -base64 48
# There is deliberately no fallback: if one of these is missing the app refuses
# to authenticate anyone rather than signing tokens with a known constant.
JWT_SECRET=
MAGIC_LINK_SECRET=
# Optional. Falls back to MAGIC_LINK_SECRET when unset.
OAUTH_STATE_SECRET=
# Optional. Minutes a sign-in link stays valid, 1-60. Defaults to 15.
MAGIC_LINK_EXPIRY_MINUTES=

# Optional. Where to send a note when someone requests access. Unset, requests
# are still stored and listed in /ops; nothing is emailed. Only this one address
# is ever mailed, never the person requesting.
ACCESS_REQUEST_NOTIFY_EMAIL=

# ── Verification sandboxes ────────────────────────────────────────────
# The write-path suite (scripts/verify-*.mjs) is only ever allowed to write
# to a Label Studio project with NO webhook. A project with one feeds the
# HEALTH backend, and anything written there is delivered and cannot be
# retracted. scripts/sandbox.mjs refuses to run against such a project, and
# also refuses if the pool named here is backed by a different project.
#
# judge  = a case assessed against a rubric, several readings per case
# author = one clinician writes, a second reads it before publication
SANDBOX_LS_PROJECT=
SANDBOX_POOL_ID=
SANDBOX_REVIEW_LS_PROJECT=
SANDBOX_REVIEW_POOL_ID=

# ── HEALTH ────────────────────────────────────────────────────────────
# The backend that decides whether a case is settled and holds the ones
# where the readings disagree. Used only by the senior review queue: held
# cases are read from it, and a senior's decision is written to it as the
# case's final answer. Unset, the queue simply never offers a held case,
# so the platform runs exactly as it did before.
HEALTH_API_URL=
HEALTH_ADMIN_KEY=
# Which header carries the key. Defaults to x-ops-key.
HEALTH_KEY_HEADER=
