# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Auth
MAGIC_LINK_SECRET=your_secret_for_signing_magic_links
JWT_SECRET=your_jwt_secret_for_sessions
MAGIC_LINK_EXPIRY_HOURS=24

# Email (Resend for magic links)
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=noreply@senebiclabs.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Operator key for internal ops endpoints (/api/internal/preview, /api/ops/*).
# NOT a client credential — the client deliverable is produced by the HEALTH backend.
OPS_API_KEY=

# Google sign-in — create an OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
# Without these, /login hides nothing but Google returns ?error=google_unavailable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Calibration gating. Off (default) means an invitation grants access directly;
# on means access is earned per pool by passing that pool's calibration.
NEXT_PUBLIC_CALIBRATION_ENABLED=false

# --- Auth secrets -----------------------------------------------------------
# All must be at least 32 characters. Generate with: openssl rand -base64 48
# There is deliberately no fallback: if one of these is missing the app refuses
# to authenticate anyone rather than signing tokens with a known constant.
JWT_SECRET=
MAGIC_LINK_SECRET=
# Optional. Falls back to MAGIC_LINK_SECRET when unset.
OAUTH_STATE_SECRET=
# Optional. Minutes a sign-in link stays valid, 1-60. Defaults to 15.
MAGIC_LINK_EXPIRY_MINUTES=

# Optional. Where to send a note when someone requests access. Unset, requests
# are still stored and listed in /ops; nothing is emailed. Only this one address
# is ever mailed, never the person requesting.
ACCESS_REQUEST_NOTIFY_EMAIL=
